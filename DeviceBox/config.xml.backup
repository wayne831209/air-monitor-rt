<?xml version="1.0" encoding="utf-8"?>
<Setting>
  <Database>
    <mysql_on>1</mysql_on>
    <IP>192.168.102.182</IP>
    <DB>ycm_energy</DB>
    <USER>Client</USER>
    <Password>root</Password>
    <machinery_factory_realtime_table1>machinery_factory_realtime</machinery_factory_realtime_table1>
    <machinery_factory_demand_table1>machinery_factory_demand</machinery_factory_demand_table1>
    <machinery_factory_devicebox_table1>devicebox</machinery_factory_devicebox_table1>
