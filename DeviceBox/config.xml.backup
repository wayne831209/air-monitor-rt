  <Factories>
    <Factory id="1" name="裝配一廠" modbusIp="192.168.210.130" modbusPort="502">
      <AlarmLimits pressureUpper="" pressureLower="" tempUpper="" tempLower="" />
      <Devices>
        <Device type="Compressor" machineNo="1" name="CO-28" enabled="true">
          <IO runDI="7" alarmDI="8" faultDI="9" controlDO="0" isReady="1" isRemote="2" />
          <Schedule enabled="false" start="08:00" end="17:00" />
        </Device>
        <Device type="Precooler" machineNo="1" name="Precooler" enabled="true">
          <IO onDI="1" offDI="2" faultDI="0" />
        </Device>
        <Device type="Dryer" machineNo="1" name="Dryer" enabled="true">
          <IO onDI="3" offDI="4" faultDI="0" />
        </Device>
        <Device type="Fan" machineNo="1" name="Fan" enabled="true">
          <IO onDI="5" offDI="6" faultDI="0" />
        </Device>
        <Device type="PressureSensor" machineNo="1" name="PressureSensor" enabled="true" />
        <Device type="ReadyStatus" machineNo="1" name="ReadyStatus" enabled="true">
          <IO readyDI="2" adam="4050" />
        </Device>
      </Devices>
    </Factory>
